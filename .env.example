# Configure these in Vercel: Settings > Environment Variables (Production and Preview).
# Without these, the deployed app can run DEMO MODE only (no real buyer data).
APP_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Add these after your eBay Developer Production keyset is available:
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_ENVIRONMENT=production

# In eBay developer Sign-in Settings:
# Accepted URL: https://YOUR-PRODUCTION-VERCEL-URL.vercel.app/api/oauth/callback
# Declined URL: https://YOUR-PRODUCTION-VERCEL-URL.vercel.app/?ebay=denied
# EBAY_RUNAME is the eBay-issued redirect URI NAME, not the full Accepted URL.
